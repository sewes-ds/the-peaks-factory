# Copy to .env on the VDS or local development machine and fill real values there.

APP_ENV=development
DATABASE_URL=postgresql://app_runtime_role:change-me@localhost:5432/the_peaks_factory
DATABASE_ADMIN_URL=postgresql://postgres:change-me@localhost:5432/postgres
DATABASE_DEPLOY_DB=the_peaks_factory_deploy_check
TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_BOT_USERNAME=change_me_bot
TELEGRAM_BOT_WEBHOOK_SECRET_TOKEN=change-me-minimum-32-characters-secret
TELEGRAM_BOT_WEBHOOK_PATH_SECRET=change-me-minimum-32-characters-path
PUBLIC_BASE_URL=https://factory.example/peaks/
TELEGRAM_SELF_BINDING_TOKEN_SECRET=change-me-minimum-32-characters-secret
TELEGRAM_SELF_BINDING_TOKEN_TTL_SECONDS=600
INTERNAL_WORKER_TOKEN=change-me-internal-worker-token
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-service-account.json
